# Optional. Without .env, both providers run in mock mode.
HOST=127.0.0.1
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Empty: generate a stable local token in data/relay-auth-token; never print it in logs.
RELAY_AUTH_TOKEN=
DATA_FILE=./data/relay-state.json
# Channel Talk only. Liner Router uses 30 s, Search Agent uses 60 s.
UPSTREAM_TIMEOUT_MS=30000

LINER_MODE=mock
LINER_API_KEY=

CHANNEL_SEND_MODE=mock
ALLOW_REAL_ALIMTALK_SEND=NO
CHANNEL_ACCESS_KEY=
CHANNEL_ACCESS_SECRET=
CHANNEL_TEMPLATE_CODE=demo-lunch-notice
# Server-only fixed text. For live mode, replace with the actual approved template.
# Only the month placeholder is supported. Configure the fixed button URL in Channel Talk.
CHANNEL_TEMPLATE_TEXT="[데모학교] #{월}월 급식 안내입니다. 이달 식단과 알레르기 표시는 아래 버튼에서 확인해 주세요."
